# Machine-specific build paths — each developer creates their own copy
**/LocalPaths.props

# Visual Studio build output
x64/
Debug/
Release/
*.user
.vs/

# Python bytecode
__pycache__/
*.pyc

# Compiled OptiX PTX shaders (generated by PreBuild from *.cu sources)
*.ptx

# Large input datasets — not versioned, store separately
SM2D/data3d_hdf5_*/

# Benchmark output CSVs and sweep logs
SM2D/benchmark_results_*.csv
SM2D/shadow_mapping_sweep_log.json

# Copied CUDA runtime DLL (installed with CUDA Toolkit)
SM2D/cudart64_*.dll

# Research drafts / LaTeX files
SM2D/*.tex
SM2D/*.log

# Temporary visualisation output
results_3d/
tmp_srp_result.csv

# Internal development notes (not needed for public repo)
CHANGES_BENCH_OPTIMIZATION.md
PORTABILITY_GUIDE.md
